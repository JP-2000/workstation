#!/bin/bash

show_osd() {
    gdbus call --session \
        --dest org.gnome.Shell \
        --object-path /org/gnome/Shell/Extensions/KeydLayerOsd \
        --method org.gnome.Shell.Extensions.KeydLayerOsd.ShowLayer \
        "$1" >/dev/null
}

keyd listen | while IFS= read -r line; do
    case "$line" in
        "/nav")
            show_osd "NAV"
            ;;

        "/utility")
            show_osd "UTILITY"
            ;;

        "/main")
            show_osd "MAIN"
            ;;
    esac
done
